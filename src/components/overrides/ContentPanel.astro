---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/ContentPanel.astro';

const { entry } = Astro.props;
const isPresentation = entry?.data?.presentation || false;
const theme = entry?.data?.theme || 'black';
---

{isPresentation ? (
  <div class="presentation-wrapper">
    <div class="reveal">
      <div class="slides" data-theme={theme}>
        <slot />
      </div>
    </div>
  </div>
) : (
  <Default {...Astro.props}>
    <slot />
  </Default>
)}

{isPresentation && (
  <script is:inline type="module">
    // Initialize reveal.js for presentation mode using dynamic imports
    (async () => {
      // Dynamically import Reveal and CSS
      const [{ default: Reveal }] = await Promise.all([
        import('/node_modules/reveal.js/dist/reveal.esm.js'),
        import('/node_modules/reveal.js/dist/reveal.css'),
      ]);

      // Import theme dynamically based on data-theme attribute
      const slides = document.querySelector('.slides');
      const theme = slides?.getAttribute('data-theme') || 'black';

      // Load theme CSS
      const loadTheme = async (themeName) => {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = `/node_modules/reveal.js/dist/theme/${themeName}.css`;
        document.head.appendChild(link);
      };

      try {
        await loadTheme(theme);
      } catch {
        console.warn(`Failed to load theme: ${theme}, falling back to black`);
        await loadTheme('black');
      }

      // Wait for DOM to be ready
      const initReveal = () => {
        const deck = new Reveal({
          embedded: false,
          hash: true,
          center: true,
          transition: 'slide',
          width: 960,
          height: 700,
          margin: 0.1,
          minScale: 0.2,
          maxScale: 2.0,
          controls: true,
          progress: true,
          slideNumber: 'c/t',
          keyboard: true,
          overview: true,
          touch: true,
          loop: false,
          rtl: false,
          fragments: true,
          help: true,
          showNotes: false,
          autoPlayMedia: null,
          preloadIframes: null,
          mouseWheel: false,
          hideInactiveCursor: true,
          hideCursorTime: 5000,
        });

        deck.initialize();

        // Handle fullscreen toggle
        window.togglePresentationFullscreen = () => {
          const elem = document.querySelector('.presentation-wrapper');
          if (!document.fullscreenElement) {
            elem?.requestFullscreen();
          } else {
            document.exitFullscreen();
          }
        };
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
    })();
  </script>

  <style is:global>
    /* Presentation mode styles */
    .presentation-wrapper {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 9999;
      background: #000;
    }

    /* Hide Starlight UI in presentation mode */
    .presentation-wrapper ~ * {
      display: none !important;
    }

    body:has(.presentation-wrapper) .header,
    body:has(.presentation-wrapper) .sidebar,
    body:has(.presentation-wrapper) .right-sidebar,
    body:has(.presentation-wrapper) .page {
      display: none !important;
    }

    body:has(.presentation-wrapper) {
      overflow: hidden;
    }

    /* Reveal.js container */
    .reveal {
      width: 100%;
      height: 100%;
    }

    /* Slide content */
    .reveal .slides section {
      text-align: left;
      padding: 20px;
    }

    .reveal h1,
    .reveal h2,
    .reveal h3,
    .reveal h4,
    .reveal h5,
    .reveal h6 {
      text-align: center;
      margin-bottom: 1em;
    }

    /* Code blocks in slides */
    .reveal pre {
      width: 100%;
      font-size: 0.55em;
      line-height: 1.4;
    }

    .reveal code {
      font-family: 'Courier New', monospace;
      padding: 2px 5px;
    }

    /* Lists */
    .reveal ul,
    .reveal ol {
      margin-left: 2em;
    }

    /* Images */
    .reveal img {
      max-width: 100%;
      max-height: 70vh;
      object-fit: contain;
    }

    /* Mermaid diagrams in slides */
    .reveal .mermaid-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 1em 0;
    }

    .reveal .mermaid {
      max-width: 100%;
      max-height: 60vh;
    }

    /* Fullscreen button */
    .presentation-fullscreen-btn {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 10000;
      padding: 10px 15px;
      background: rgba(0, 0, 0, 0.5);
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 5px;
      cursor: pointer;
      font-size: 14px;
    }

    .presentation-fullscreen-btn:hover {
      background: rgba(0, 0, 0, 0.8);
    }
  </style>
)}

<button
  class="presentation-fullscreen-btn"
  onclick="togglePresentationFullscreen()"
  style={isPresentation ? '' : 'display: none;'}
>
  Toggle Fullscreen
</button>
